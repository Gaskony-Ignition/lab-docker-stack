# Settings this machine is allowed to keep.
#
#     cp demo-settings.env.example .demo-settings.env     then edit it
#
# CHANGING SOMETHING HERE SURVIVES AN UPDATE. Anything else you change in a
# gateway's own UI does not: the setup scripts write the wanted value back,
# which is what lets the rig return to a known state. See the table in
# docs/RELEASING.md, and `make drift` to see what currently differs.
#
# `.demo-settings.env` is gitignored. This template is committed, so a new knob
# arrives with an update and you can see it. Copying the template again is safe;
# only the keys you uncomment do anything.
#
# Every value here can also be given for one command:
#     KEEPALIVE=20 ./wd mqtt-setup

# --- MQTT -------------------------------------------------------------------

# Seconds between an MQTT client's keepalive pings, written to every
# Transmission and Engine server in the rig (scripts/ign-mqtt.sh).
#
# The rolling buffer's max age must stay at or above 1.5x this, or a reconnect
# can arrive after the buffer has already dropped the gap it was holding.
#KEEPALIVE=10

# How long each edge's Rolling History Buffer holds tag history while it cannot
# reach the broker, in seconds (scripts/sf-arm.sh). Raise it to demonstrate a
# longer outage; the gap has to fit inside it.
#ROLLING_MAX_AGE=60

# --- the MQTT demo's Sparkplug shape ----------------------------------------
#
# All three take an EMPTY value to mean "leave whatever the gateway has alone",
# which is not the same as "write the default". That is how to hand a gateway
# over to an engineer to experiment with and have the scripts stop arguing.

# Publish UDT member tags as flat metrics instead of as a UDT instance.
#SPARKPLUG_CONVERT_UDTS=false

# Publish the UDT DEFINITIONS in the birth certificate, so a subscriber can
# build the type without being told it separately.
#SPARKPLUG_PUBLISH_UDT_DEFS=true

# Which path MQTT Engine puts in an alarm's display path: ENGINE or SOURCE.
#SPARKPLUG_DISPLAY_PATH_TYPE=ENGINE

# --- the console's demonstrations -------------------------------------------

# How many seconds a broker cut from the demo console lasts by default. The
# console's own buttons pass their own number, so this is the floor the control
# plane uses when it is not told (control/mqttcut.py enforces 5..600).
#WD_MQTT_CUT_SECONDS=60
