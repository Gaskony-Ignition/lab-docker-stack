TZ=Australia/Adelaide

# Consumed on FIRST startup only, while the broker_data volume is empty.
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=__GEN__

# --- Host-side published ports ------------------------------------------
# The defaults below are what the compose file falls back to. Uncomment and
# change one ONLY on a machine where something else already owns that port.
# MQTT itself is NOT published: every client is a container on wd-mqtt.
#BROKER_HTTP_HOST_PORT=29788
#BROKER_HTTPS_HOST_PORT=29743

# --- Compose project name -------------------------------------------------
# See ignition-edge3/.env.example -- changing this orphans the data volume.
#COMPOSE_PROJECT_NAME=ignition-broker
