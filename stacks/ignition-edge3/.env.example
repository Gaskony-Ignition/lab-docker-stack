TZ=Australia/Adelaide

# Consumed on FIRST startup only, while the edge3_data volume is empty.
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=__GEN__

# --- Host-side published ports ------------------------------------------
# The defaults below are what the compose file falls back to and match the
# documented layout. Uncomment and change one ONLY on a machine where
# something else already owns that port -- container-internal ports and
# every backbone address stay the same either way.
#EDGE3_HTTP_HOST_PORT=29588
#EDGE3_HTTPS_HOST_PORT=29543
#EDGE3_OPCUA_HOST_PORT=29541

# --- Compose project name -------------------------------------------------
# Sets the Compose project, which prefixes this stack's volume names. Leave it
# alone unless another Compose project on this machine already uses the same
# name -- Compose matches existing containers by project+service label, so a
# collision makes `up -d` silently adopt the other project's container instead
# of starting yours. Changing this on a machine that already has data ORPHANS
# that data: the volumes get looked up under the new prefix.
#COMPOSE_PROJECT_NAME=ignition-edge3
