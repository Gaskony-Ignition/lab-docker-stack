TZ=Australia/Adelaide

# --- Host-side published ports ------------------------------------------
# The defaults below are what the compose file falls back to and match the
# documented layout. Uncomment and change one ONLY on a machine where
# something else already owns that port -- container-internal ports and
# every backbone address stay the same either way.
#
# The page does not use this port: it calls http://wd-control:8080 by container
# name on `backbone`, like everything else. This is for curl from the host and
# for reading /state when the page itself is what you are debugging.
#WD_CONTROL_HTTP_HOST_PORT=29485

# --- Compose project name -------------------------------------------------
# Sets the Compose project, which prefixes this stack's volume names. Leave it
# alone unless another Compose project on this machine already uses the same
# name -- Compose matches existing containers by project+service label, so a
# collision makes `up -d` silently adopt the other project's container instead
# of starting yours. Changing this on a machine that already has data ORPHANS
# that data: the volumes get looked up under the new prefix.
#COMPOSE_PROJECT_NAME=wd-control

# --- THE WIRE's MQTT listener (control/wire.py) --------------------------------
# Defaults are in compose.yaml. Brokers are tried in order; the first that
# accepts wins, and the witness POSTs go to that gateway's :8088.
#WD_WIRE=on
#WD_WIRE_BROKERS=ignition:8883,ignition-backup:8883
#WD_WIRE_CREDS=/work/.secrets.env

# --- MQTT cuts (control/mqttcut.py) ------------------------------------------
# The edges POST /mqtt/cut may take off wd-mqtt. The token is WD_CONTROL_TOKEN
# in the root .secrets.env (generated by make env), not here.
#WD_MQTT_CUTTABLE=ignition-edge2,ignition-edge3,ignition-edge4
# How long a cut lasts when the caller does not say, in seconds (5..600).
# The console's buttons pass their own number; this is the fallback.
#WD_MQTT_CUT_SECONDS=60
#WD_WIRE_POST_URL=
