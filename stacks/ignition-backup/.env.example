TZ=Australia/Adelaide

# Consumed on FIRST startup only, while the backup_data volume is empty.
# Deliberately the same keys as the hub: make-env.sh resolves both from the one
# .secrets.env entry, so master and backup commission with identical
# credentials. Redundancy syncs the user source from the master, and a backup
# that started with a different password would have it changed underneath it on
# the first sync.
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=__GEN__

# --- Host-side published ports ------------------------------------------
# The defaults below are what the compose file falls back to and match the
# documented layout (hub 8088, edge1 8188, edge2 8288, backup 8388). Uncomment
# and change one ONLY on a machine where something else already owns that port
# -- container-internal ports and every backbone address stay the same either
# way, and the redundancy link between the pair never touches these at all.
#BACKUP_HTTP_HOST_PORT=29388
#BACKUP_HTTPS_HOST_PORT=29343
#BACKUP_OPCUA_HOST_PORT=29341

# --- Compose project name -------------------------------------------------
# Sets the Compose project, which prefixes this stack's volume names. Leave it
# alone unless another Compose project on this machine already uses the same
# name -- Compose matches existing containers by project+service label, so a
# collision makes `up -d` silently adopt the other project's container instead
# of starting yours. Changing this on a machine that already has data ORPHANS
# that data: the volumes get looked up under the new prefix.
#COMPOSE_PROJECT_NAME=ignition-backup
