  "params": {},
  "propConfig": {
    "custom.base": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "runScript('sp_site.instance_path()', 0)"
        }
      }
    },
    "custom.device": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "runScript('sp_site.device_path()', 0)"
        }
      }
    },
    "custom.headline": {
      "binding": {
        "type": "expr",
        "config": {
