        "meta": {
          "name": "auto"
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "4px",
            "width": "100%"
          }
        },
        "position": {
          "shrink": 0
        },
        "children": [
          {
            "type": "ia.display.view",
            "meta": {
