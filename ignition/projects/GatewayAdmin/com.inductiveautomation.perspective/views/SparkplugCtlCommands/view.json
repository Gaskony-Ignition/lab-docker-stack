                "width": "100%"
              }
            },
            "position": {
              "basis": "0px",
              "grow": 1,
              "shrink": 1
            },
            "propConfig": {
              "props.params.can": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.c.can.auto0}"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.view",
            "meta": {
              "name": "auto1"
            },
            "props": {
              "path": "RailButton",
              "params": {
                "key": "mqtt.cmd.auto1",
                "action": "mqtt.cmd.auto1",
                "icon": "material/autorenew",
                "kind": "chip",
                "quiet": true
              },
              "useDefaultViewHeight": false,
              "useDefaultViewWidth": false,
              "style": {
                "width": "100%"
              }
            },
            "position": {
              "basis": "0px",
              "grow": 1,
              "shrink": 1
            },
            "propConfig": {
              "props.params.can": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.c.can.auto1}"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "manual"
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "4px",
            "width": "100%"
          }
        },
        "position": {
          "shrink": 0
        },
        "children": [
          {
            "type": "ia.display.view",
            "meta": {
              "name": "manual0"
            },
            "props": {
              "path": "RailButton",
              "params": {
                "key": "mqtt.cmd.manual0",
                "action": "mqtt.cmd.manual0",
                "icon": "material/pan_tool",
                "kind": "chip",
                "quiet": true
              },
              "useDefaultViewHeight": false,
              "useDefaultViewWidth": false,
              "style": {
                "width": "100%"
              }
            },
            "position": {
              "basis": "0px",
              "grow": 1,
              "shrink": 1
            },
            "propConfig": {
              "props.params.can": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.c.can.manual0}"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.view",
            "meta": {
              "name": "manual1"
            },
            "props": {
              "path": "RailButton",
              "params": {
                "key": "mqtt.cmd.manual1",
                "action": "mqtt.cmd.manual1",
                "icon": "material/pan_tool",
                "kind": "chip",
                "quiet": true
              },
              "useDefaultViewHeight": false,
              "useDefaultViewWidth": false,
              "style": {
                "width": "100%"
              }
            },
            "position": {
              "basis": "0px",
              "grow": 1,
              "shrink": 1
            },
            "propConfig": {
              "props.params.can": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.c.can.manual1}"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "note"
        },
        "props": {
          "text": "",
          "style": {
            "fontSize": "10px",
            "lineHeight": 1.35,
            "minWidth": "0",
            "overflow": "hidden",
            "textOverflow": "ellipsis",
            "whiteSpace": "nowrap"
          },
          "tooltip": {
            "enabled": true
          }
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(indexOf({session.custom.acting}, 'mqtt.cmd.') = 0, {session.custom.actingWhat}, if(indexOf({session.custom.actKey}, 'mqtt.cmd.') = 0, {session.custom.actNote}, ''))"
              }
            }
          },
          "props.tooltip.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(indexOf({session.custom.acting}, 'mqtt.cmd.') = 0, {session.custom.actingWhat}, if(indexOf({session.custom.actKey}, 'mqtt.cmd.') = 0, {session.custom.actNote}, ''))"
              }
            }
          },
          "props.style.classes": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{session.custom.style} + '/text/muted'"
              }
            }
          },
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.c.ready} && if(indexOf({session.custom.acting}, 'mqtt.cmd.') = 0, {session.custom.actingWhat}, if(indexOf({session.custom.actKey}, 'mqtt.cmd.') = 0, {session.custom.actNote}, '')) != ''"
              }
            }
          }
        }
      }
    ]
  },
  "propConfig": {
    "custom.c": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "now(2000)"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\timport sparkplug_demo\n\treturn sparkplug_demo.ctl('commands')\n"
          }
        ]
      }
    }
  }
}
