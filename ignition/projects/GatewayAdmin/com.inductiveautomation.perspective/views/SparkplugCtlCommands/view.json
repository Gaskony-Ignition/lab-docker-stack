            },
            "props": {
              "path": "RailButton",
              "params": {
                "key": "mqtt.cmd.auto0",
                "action": "mqtt.cmd.auto0",
                "icon": "material/autorenew",
                "kind": "chip",
                "quiet": true
              },
              "useDefaultViewHeight": false,
              "useDefaultViewWidth": false,
