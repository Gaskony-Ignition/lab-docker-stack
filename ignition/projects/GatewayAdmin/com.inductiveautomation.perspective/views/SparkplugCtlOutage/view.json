{
  "custom": {
    "c": {
      "ready": false,
      "can": {}
    }
  },
  "params": {},
  "props": {
    "defaultSize": {
      "width": 232,
      "height": 60
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "gap": "4px",
        "width": "100%",
        "paddingTop": "2px"
      }
    },
    "position": {
      "shrink": 0
    },
    "children": [
      {
        "type": "ia.display.view",
        "meta": {
          "name": "cut"
        },
        "props": {
          "path": "RailButton",
          "params": {
            "key": "mqtt.out.cut",
            "action": "mqtt.out.cut",
            "icon": "material/link_off",
            "kind": "chip",
            "quiet": true
          },
          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false,
          "style": {
            "width": "100%"
          }
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.can": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.c.can.cut}"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "restore"
        },
        "props": {
          "path": "RailButton",
          "params": {
            "key": "mqtt.out.restore",
            "action": "mqtt.out.restore",
            "icon": "material/link",
            "kind": "primary",
            "quiet": true
          },
          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false,
          "style": {
            "width": "100%"
          }
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.can": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.c.can.restore}"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "rebirth"
        },
        "props": {
          "path": "RailButton",
          "params": {
            "key": "mqtt.out.rebirth",
            "action": "mqtt.out.rebirth",
            "icon": "material/refresh",
            "kind": "chip",
            "quiet": true
          },
          "useDefaultViewHeight": false,
          "useDefaultViewWidth": false,
          "style": {
            "width": "100%"
          }
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.can": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.c.can.rebirth}"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "note"
        },
        "props": {
          "text": "",
          "style": {
            "fontSize": "10px",
            "lineHeight": 1.35,
            "minWidth": "0",
            "overflow": "hidden",
            "textOverflow": "ellipsis",
            "whiteSpace": "nowrap"
          },
          "tooltip": {
            "enabled": true
          }
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(indexOf({session.custom.acting}, 'mqtt.out.') = 0, {session.custom.actingWhat}, if(indexOf({session.custom.actKey}, 'mqtt.out.') = 0, {session.custom.actNote}, ''))"
              }
            }
          },
          "props.tooltip.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(indexOf({session.custom.acting}, 'mqtt.out.') = 0, {session.custom.actingWhat}, if(indexOf({session.custom.actKey}, 'mqtt.out.') = 0, {session.custom.actNote}, ''))"
              }
            }
          },
          "props.style.classes": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{session.custom.style} + '/text/muted'"
              }
            }
          },
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.c.ready} && if(indexOf({session.custom.acting}, 'mqtt.out.') = 0, {session.custom.actingWhat}, if(indexOf({session.custom.actKey}, 'mqtt.out.') = 0, {session.custom.actNote}, '')) != ''"
              }
            }
          }
        }
      }
    ]
  },
  "propConfig": {
    "custom.c": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "now(2000)"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\timport sparkplug_demo\n\treturn sparkplug_demo.ctl('outage')\n"
          }
        ]
      }
    }
  }
}
