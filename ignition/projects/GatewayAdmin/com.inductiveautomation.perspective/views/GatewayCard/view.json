{
  "custom": {},
  "params": {
    "footer": "",
    "icon": "edge",
    "label": "",
    "metrics": [],
    "state": "",
    "state2": "",
    "state2Level": "good",
    "stateLevel": "warn",
    "sublabel": ""
  },
  "propConfig": {
    "params.footer": {
      "paramDirection": "input"
    },
    "params.icon": {
      "paramDirection": "input"
    },
    "params.label": {
      "paramDirection": "input"
    },
    "params.metrics": {
      "paramDirection": "input"
    },
    "params.state": {
      "paramDirection": "input"
    },
    "params.state2": {
      "paramDirection": "input"
    },
    "params.state2Level": {
      "paramDirection": "input"
    },
    "params.stateLevel": {
      "paramDirection": "input"
    },
    "params.sublabel": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 168,
      "width": 380
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "icon"
            },
            "position": {
              "basis": "52px",
              "shrink": 0
            },
            "propConfig": {
              "props.source": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.icon} = 'standard', 'data:image/svg+xml;base64,', 'data:image/svg+xml;base64,')"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "fit": {
                "height": 100,
                "mode": "contain",
                "scroll": false,
                "width": 100
              },
              "style": {
                "height": "72px",
                "width": "52px",
                "lineHeight": "0",
                "fontSize": "0"
              }
            },
            "type": "ia.display.image"
          },
          {
            "children": [
              {
                "children": [
                  {
                    "children": [
                      {
                        "meta": {
                          "name": "gname"
                        },
                        "position": {
                          "shrink": 0
                        },
                        "propConfig": {
                          "props.style.classes": {
                            "binding": {
                              "config": {
                                "expression": "{session.custom.style} + '/text/card-title'"
                              },
                              "type": "expr"
                            }
                          },
                          "props.text": {
                            "binding": {
                              "config": {
                                "expression": "{view.params.label}"
                              },
                              "type": "expr"
                            }
                          }
                        },
                        "props": {
                          "style": {
                            "minWidth": "0",
                            "overflow": "hidden",
                            "textOverflow": "ellipsis",
                            "whiteSpace": "nowrap",
                            "lineHeight": "1.35"
                          },
                          "text": ""
                        },
                        "type": "ia.display.label"
                      },
                      {
                        "meta": {
                          "name": "grole"
                        },
                        "position": {
                          "shrink": 0
                        },
                        "propConfig": {
                          "props.style.classes": {
                            "binding": {
                              "config": {
                                "expression": "{session.custom.style} + '/text/muted'"
                              },
                              "type": "expr"
                            }
                          },
                          "props.text": {
                            "binding": {
                              "config": {
                                "expression": "{view.params.sublabel}"
                              },
                              "type": "expr"
                            }
                          }
                        },
                        "props": {
                          "style": {
                            "fontSize": "11px",
                            "marginTop": "-2px",
                            "minWidth": "0",
                            "overflow": "hidden",
                            "textOverflow": "ellipsis",
                            "whiteSpace": "nowrap"
                          },
                          "text": ""
                        },
                        "type": "ia.display.label"
                      }
                    ],
                    "meta": {
                      "name": "titles"
                    },
                    "position": {
                      "basis": "auto",
                      "grow": 1,
                      "shrink": 1
                    },
                    "props": {
                      "direction": "column",
                      "style": {
                        "gap": "0px",
                        "minWidth": "0",
                        "overflow": "hidden"
                      }
                    },
                    "type": "ia.container.flex"
                  },
                  {
                    "children": [
                      {
                        "meta": {
                          "name": "state"
                        },
                        "position": {
                          "shrink": 0
                        },
                        "propConfig": {
                          "props.style.classes": {
                            "binding": {
                              "config": {
                                "expression": "{session.custom.style} + '/status/' + if({view.params.stateLevel} = 'good', 'badge-ok', if({view.params.stateLevel} = 'bad', 'badge-alarm', if({view.params.stateLevel} = 'neutral', 'badge-neutral', 'badge-warn')))"
                              },
                              "type": "expr"
                            }
                          },
                          "props.text": {
                            "binding": {
                              "config": {
                                "expression": "{view.params.state}"
                              },
                              "type": "expr"
                            }
                          }
                        },
                        "props": {
                          "style": {
                            "whiteSpace": "nowrap",
                            "overflow": "hidden",
                            "textOverflow": "ellipsis"
                          },
                          "text": ""
                        },
                        "type": "ia.display.label"
                      },
                      {
                        "meta": {
                          "name": "state2"
                        },
                        "position": {
                          "shrink": 0
                        },
                        "propConfig": {
                          "meta.visible": {
                            "binding": {
                              "config": {
                                "expression": "{view.params.state2} != ''"
                              },
                              "type": "expr"
                            }
                          },
                          "props.style.classes": {
                            "binding": {
                              "config": {
                                "expression": "{session.custom.style} + '/status/' + if({view.params.state2Level} = 'good', 'badge-ok', if({view.params.state2Level} = 'bad', 'badge-alarm', if({view.params.state2Level} = 'neutral', 'badge-neutral', 'badge-warn')))"
                              },
                              "type": "expr"
                            }
                          },
                          "props.text": {
                            "binding": {
                              "config": {
                                "expression": "{view.params.state2}"
                              },
                              "type": "expr"
                            }
                          }
                        },
                        "props": {
                          "style": {
                            "whiteSpace": "nowrap",
                            "overflow": "hidden",
                            "textOverflow": "ellipsis"
                          },
                          "text": ""
                        },
                        "type": "ia.display.label"
                      }
                    ],
                    "meta": {
                      "name": "badges"
                    },
                    "position": {
                      "basis": "auto",
                      "shrink": 0
                    },
                    "props": {
                      "alignItems": "center",
                      "direction": "row",
                      "style": {
                        "gap": "6px",
                        "overflow": "hidden",
                        "justifyContent": "flex-end"
                      },
                      "wrap": "wrap"
                    },
                    "type": "ia.container.flex"
                  }
                ],
                "meta": {
                  "name": "header"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "alignItems": "stretch",
                  "direction": "row",
                  "style": {
                    "gap": "8px",
                    "width": "100%",
                    "overflow": "hidden"
                  },
                  "wrap": "wrap"
                },
                "type": "ia.container.flex"
              },
              {
                "meta": {
                  "name": "metrics"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.instances": {
                    "binding": {
                      "config": {
                        "expression": "{view.params.metrics}"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "alignItems": "stretch",
                  "direction": "row",
                  "elementPosition": {
                    "basis": "0px",
                    "grow": 1,
                    "shrink": 1
                  },
                  "instances": [],
                  "path": "CardMetric",
                  "style": {
                    "gap": "8px",
                    "minWidth": "0",
                    "width": "100%",
                    "overflow": "hidden"
                  },
                  "useDefaultViewHeight": true,
                  "useDefaultViewWidth": false
                },
                "type": "ia.display.flex-repeater"
              },
              {
                "meta": {
                  "name": "footer"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "config": {
                        "expression": "{session.custom.style} + '/text/muted'"
                      },
                      "type": "expr"
                    }
                  },
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "{view.params.footer}"
                      },
                      "type": "expr"
                    }
                  },
                  "meta.visible": {
                    "binding": {
                      "config": {
                        "expression": "{view.params.footer} != ''"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontSize": "11px",
                    "marginTop": "auto",
                    "minWidth": "0",
                    "overflow": "hidden",
                    "textOverflow": "ellipsis",
                    "whiteSpace": "nowrap"
                  },
                  "text": ""
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "body"
            },
            "position": {
              "basis": "0px",
              "grow": 1,
              "shrink": 1
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "8px",
                "minWidth": "0",
                "width": "100%",
                "overflow": "hidden"
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "row"
        },
        "position": {
          "basis": "auto",
          "grow": 1,
          "shrink": 1
        },
        "props": {
          "alignItems": "center",
          "direction": "row",
          "style": {
            "gap": "12px",
            "height": "100%",
            "minWidth": "0",
            "width": "100%",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "position": {
      "basis": "auto",
      "shrink": 0
    },
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "{session.custom.style} + '/containers/card'"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "gap": "0px",
        "height": "100%",
        "minWidth": "0",
        "width": "100%",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
