{
  "custom": {
    "info": {},
    "secret": "",
    "shown": false
  },
  "params": {
    "stack": ""
  },
  "propConfig": {
    "custom.info": {
      "binding": {
        "config": {
          "expression": "{view.params.stack}"
        },
        "transforms": [
          {
            "code": "\timport ui_creds\n\treturn ui_creds.summary(value)\n",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "params.stack": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 250,
      "width": 420
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "title"
            },
            "position": {
              "basis": "auto",
              "grow": 0,
              "shrink": 0
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "{session.custom.style} + '/text/card-title'"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "{view.custom.info.label} + ' sign-in'"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "lineHeight": 1.4
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "why"
            },
            "position": {
              "basis": "auto",
              "grow": 0,
              "shrink": 0
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "{session.custom.style} + '/text/muted'"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "{view.custom.info.why}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "lineHeight": 1.45
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "user"
            },
            "position": {
              "basis": "auto",
              "grow": 0,
              "shrink": 0
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "{session.custom.style} + '/text/muted'"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "'Username:  ' + {view.custom.info.user}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "fontFamily": "monospace",
                "lineHeight": 1.5
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "secret"
            },
            "position": {
              "basis": "auto",
              "grow": 0,
              "shrink": 0
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "{session.custom.style} + '/text/muted'"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.shown}, 'Password:  ' + {view.custom.secret}, 'Password:  ••••••••••••')"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "fontFamily": "monospace",
                "lineHeight": 1.5
              }
            },
            "type": "ia.display.label"
          },
          {
            "children": [
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\t# Gateway scope -- a \"C\" scoped handler here silently does nothing.\n\t#\n\t# The secret is fetched ON THE CLICK and put on a VIEW custom prop, not\n\t# a session one: a session prop outlives the popup and would leave the\n\t# password readable in the property tree of every page in the session.\n\timport ui_creds\n\tif self.view.custom.shown:\n\t\tself.view.custom.secret = ''\n\t\tself.view.custom.shown = False\n\telse:\n\t\tself.view.custom.secret = ui_creds.password(self.view.params.stack)\n\t\tself.view.custom.shown = True\n"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "reveal"
                },
                "position": {
                  "basis": "auto",
                  "grow": 0,
                  "shrink": 0
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "config": {
                        "expression": "{session.custom.style} + '/buttons/primary'"
                      },
                      "type": "expr"
                    }
                  },
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "if({view.custom.shown}, 'Hide', 'Reveal password')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "height": "32px",
                    "minHeight": "32px",
                    "padding": "0 14px",
                    "whiteSpace": "nowrap"
                  }
                },
                "type": "ia.input.button"
              },
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tsystem.perspective.closePopup('wd-creds')\n"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "close"
                },
                "position": {
                  "basis": "auto",
                  "grow": 0,
                  "shrink": 0
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "config": {
                        "expression": "{session.custom.style} + '/buttons/chip'"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "height": "32px",
                    "minHeight": "32px",
                    "padding": "0 14px",
                    "whiteSpace": "nowrap"
                  },
                  "text": "Close"
                },
                "type": "ia.input.button"
              }
            ],
            "meta": {
              "name": "actions"
            },
            "position": {
              "basis": "auto",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "alignItems": "center",
              "direction": "row",
              "justify": "flex-start",
              "style": {
                "gap": "8px"
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "shell"
        },
        "position": {
          "basis": "auto",
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "{session.custom.style} + '/containers/page'"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "direction": "column",
          "style": {
            "height": "100%",
            "minHeight": "0",
            "overflow": "auto",
            "padding": "18px 20px",
            "width": "100%"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "height": "100%",
        "minHeight": "0",
        "width": "100%"
      }
    },
    "type": "ia.container.flex"
  }
}
