      {
        "type": "ia.container.flex",
        "meta": {
          "name": "tryWatch"
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "8px",
            "classes": "sp-try"
          },
          "alignItems": "center"
        },
        "position": {
          "shrink": 0
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "tryText",
              "tooltip": {
                "enabled": true
              }
            },
            "props": {
              "text": "Compare each tag at the edge and in the cloud: the cloud copy follows within about a second.",
              "style": {
                "lineHeight": "1.35",
                "whiteSpace": "nowrap",
                "minWidth": "0",
                "classes": "sp-ellipsis"
              }
            },
            "position": {
              "basis": "0px",
              "grow": 1,
              "shrink": 1
            },
            "propConfig": {
              "meta.tooltip.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "'Compare each tag at the edge and in the cloud: the cloud copy follows within about a second.'"
                  }
                }
              }
            }
          }
        ]
