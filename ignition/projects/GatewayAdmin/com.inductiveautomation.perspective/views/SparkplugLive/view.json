    "defaultSize": {
      "width": 1200,
      "height": 400
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "height": "100%",
        "width": "100%",
        "gap": "8px",
        "overflow": "hidden",
        "paddingBottom": "4px",
