                          "type": "expr",
                          "config": {
                            "expression": "{view.custom.strip.brokerNode}"
                          }
                        }
                      }
                    }
                  }
                ]
              },
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "laneOut"
                },
                "props": {
                  "direction": "column",
                  "style": {
                    "gap": "6px",
                    "padding": "0 10px",
                    "minWidth": "72px",
                    "overflow": "hidden"
                  },
                  "alignItems": "center",
                  "justify": "center"
                },
                "position": {
                  "basis": "0px",
                  "grow": 1,
                  "shrink": 1
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "data",
                      "tooltip": {
                        "enabled": true
                      }
                    },
                    "props": {
                      "text": "",
                      "style": {
                        "lineHeight": "1.35",
                        "whiteSpace": "nowrap"
                      }
                    },
                    "position": {
                      "shrink": 0
                    },
                    "propConfig": {
                      "props.style.classes": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "{session.custom.style} + '/status/' + {view.custom.strip.dataLane.badge}"
                          }
                        }
                      },
                      "props.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "{view.custom.strip.dataLane.text}"
                          }
                        }
                      },
                      "meta.tooltip.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "{view.custom.strip.dataLane.why}"
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "cmd",
                      "tooltip": {
                        "enabled": true
                      }
                    },
                    "props": {
                      "text": "",
                      "style": {
                        "lineHeight": "1.35",
                        "whiteSpace": "nowrap"
                      }
                    },
                    "position": {
                      "shrink": 0
                    },
                    "propConfig": {
                      "props.style.classes": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "{session.custom.style} + '/status/' + {view.custom.strip.cmdLane.badge}"
                          }
                        }
                      },
                      "props.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "{view.custom.strip.cmdLane.text}"
                          }
                        }
                      },
                      "meta.tooltip.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "{view.custom.strip.cmdLane.why}"
                          }
                        }
                      }
                    }
                  }
                ]
              },
              {
                "type": "ia.display.view",
                "meta": {
                  "name": "cloud"
                },
                "props": {
                  "path": "StripNode",
                  "useDefaultViewHeight": false,
                  "useDefaultViewWidth": false,
                  "style": {
                    "minWidth": "0",
                    "width": "100%"
                  }
                },
                "position": {
                  "basis": "23%",
                  "shrink": 0
                },
                "propConfig": {
                  "props.params": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "{view.custom.strip.cloudNode}"
                      }
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "ia.display.view",
            "meta": {
              "name": "panel"
            },
            "props": {
              "path": "SparkplugLive",
              "style": {
                "minHeight": "0",
                "width": "100%"
              }
            },
            "position": {
              "basis": "0px",
              "grow": 1,
              "shrink": 1
            },
            "propConfig": {
              "props.path": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "case({view.custom.scenario}, 0, 'SparkplugLive', 1, 'SparkplugAlarms', 2, 'SparkplugCommands', 3, 'SparkplugOutage', 4, 'SparkplugUdt', 5, 'SparkplugNotify', 'SparkplugLive')"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  },
  "propConfig": {
    "custom.strip": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "now(2000)"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\timport sparkplug_demo\n\treturn sparkplug_demo.page_strip()\n"
          }
        ]
      }
    },
    "custom.rail": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "now(3000)"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\timport demo_rail\n\treturn demo_rail.rail('sparkplug')\n"
          }
        ]
      }
    }
  }
}
