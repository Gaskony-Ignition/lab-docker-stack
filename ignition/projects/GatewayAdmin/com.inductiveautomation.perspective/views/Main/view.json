                      },
                      "transforms": [
                        {
                          "code": "\timport demo_guide\n\treturn demo_guide.has_guide(value)\n",
                          "type": "script"
                        }
                      ],
                      "type": "expr"
                    }
                  },
                  "props.style.classes": {
                    "binding": {
                      "config": {
                        "expression": "{session.custom.style} + '/buttons/chip'"
                      },
                      "type": "expr"
                    }
                  }
