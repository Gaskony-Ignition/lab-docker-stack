              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tsystem.perspective.openPopup(\n\t\t'styles-template-switcher',\n\t\t'Appearance/Switcher',\n\t\t# THIS REPO'S OWN VIEW, generated by scripts/gen-themes.py. It was\n\t\t# upstream's inherited switcher until the themes cutover; the comment\n\t\t# that used to sit here still said so, and said the size came from\n\t\t# upstream's own min() sizing, months after both stopped being true.\n\t\t#\n\t\t# It writes session.custom.styleOverride rather than\n\t\t# session.custom.style, because style is BOUND (it prefers the override,\n\t\t# else the committed theme, on a 5s poll) and a bound property swallows\n\t\t# a write in silence. Committing to every project -- the only form that\n\t\t# travels over EAM -- is the separate 'Apply everywhere' button.\n\t\t#\n\t\t# SIZE COMES FROM THE VIEW'S OWN props.defaultSize (560x460), not from\n\t\t# here. openPopup HAS NO width OR height ARGUMENT -- see\n\t\t# gen-themes.py:gen_switcher for the reflection and the measurements.\n\t\t# Unknown kwargs are swallowed in silence, so a size passed here reads\n\t\t# as working and does nothing at all. A per-call override is\n\t\t# position={'width': N, 'height': N} -- integers, pixels, no CSS.\n\t\ttitle='Theme',\n\t\tmodal=True,\n\t\tdraggable=True,\n\t\tresizable=False,\n\t\toverlayDismiss=True,\n\t\tviewportBound=True)\n"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "appearance"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "config": {
                        "expression": "{session.custom.style} + if({view.custom.tab} = -1, '/buttons/primary', '/buttons/chip')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
