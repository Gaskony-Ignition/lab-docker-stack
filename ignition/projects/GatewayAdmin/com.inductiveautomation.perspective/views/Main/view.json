              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\timport demo_guide\n\ttopic = demo_guide.topic_for_tab(self.view.custom.tab)\n\tif topic:\n\t\tsystem.perspective.openPopup(\n\t\t\t'demo-guide', 'Guide/Panel',\n\t\t\tparams={'topic': topic},\n\t\t\tposition=demo_guide.popup_size(topic),\n\t\t\ttitle='How to show this', modal=True, draggable=True,\n\t\t\tresizable=True, overlayDismiss=True, viewportBound=True)\n"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "guide"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
