                    "lineHeight": "1",
                    "minHeight": "30px",
                    "padding": "0 14px",
                    "whiteSpace": "nowrap"
                  },
                  "text": "Theme"
                },
                "type": "ia.input.button"
              },
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\timport demo_styles\n\tpack = self.session.custom.style\n\tself.session.custom.styleOverride = ''\n\tself.session.custom.status = demo_styles.commit_pack(pack)\n"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "applyTheme"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "meta.visible": {
                    "binding": {
                      "config": {
                        "expression": "runScript('demo_styles.preview_pack', 5000, {session.custom.styleOverride}) != ''"
                      },
                      "type": "expr"
                    }
                  },
                  "props.style.classes": {
                    "binding": {
                      "config": {
                        "expression": "{session.custom.style} + '/status/badge-warn'"
                      },
                      "type": "expr"
                    }
                  },
                  "props.style.padding": {
                    "binding": {
                      "config": {
                        "expression": "if(runScript('demo_styles.preview_pack', 5000, {session.custom.styleOverride}) != '', '0 12px', '0px')"
                      },
                      "type": "expr"
                    }
                  },
                  "props.style.width": {
                    "binding": {
                      "config": {
                        "expression": "if(runScript('demo_styles.preview_pack', 5000, {session.custom.styleOverride}) != '', 'auto', '0px')"
                      },
                      "type": "expr"
                    }
                  },
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "'Apply ' + runScript('demo_styles.preview_pack', 5000, {session.custom.styleOverride}) + ' everywhere'"
                      },
                      "type": "expr"
                    }
                  },
                  "props.tooltip.text": {
                    "binding": {
                      "config": {
                        "expression": "runScript('demo_styles.preview_warning', 5000, {session.custom.styleOverride})"
                      },
                      "type": "expr"
