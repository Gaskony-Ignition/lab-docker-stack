  "propConfig": {
    "custom.d": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "now(1500)"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\timport sparkplug_demo\n\treturn sparkplug_demo.page_traffic()\n"
          }
        ]
      }
    }
