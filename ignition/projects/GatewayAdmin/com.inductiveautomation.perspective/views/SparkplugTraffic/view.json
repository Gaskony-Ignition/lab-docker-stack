              "config": {
                "expression": "{view.custom.d.events}"
              }
            }
          },
          "position.basis": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "toStr(32 + 28 * max(3, floor(({page.props.dimensions.viewport.height} - 236 - 110 - 32) / 28))) + 'px'"
              }
            }
          }
        }
