{
  "custom": {},
  "params": {
    "badge": "badge-neutral",
    "line": "",
    "name": "",
    "state": "",
    "tip": ""
  },
  "propConfig": {
    "params.badge": {
      "paramDirection": "input"
    },
    "params.line": {
      "paramDirection": "input"
    },
    "params.name": {
      "paramDirection": "input"
    },
    "params.state": {
      "paramDirection": "input"
    },
    "params.tip": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 44,
      "width": 300
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "name"
            },
            "position": {
              "basis": "auto",
              "grow": 1,
              "shrink": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "{view.params.name}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "fontSize": "13px",
                "fontWeight": "600",
                "lineHeight": 1.35,
                "minWidth": "0",
                "overflow": "hidden",
                "textOverflow": "ellipsis",
                "whiteSpace": "nowrap"
              },
              "text": ""
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "state"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "{view.params.state} != ''"
                  },
                  "type": "expr"
                }
              },
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "{session.custom.style} + '/status/' + {view.params.badge}"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "{view.params.state}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "fontSize": "10px",
                "lineHeight": 1.4,
                "padding": "0 8px",
                "whiteSpace": "nowrap"
              },
              "text": ""
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "top"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "direction": "row",
          "style": {
            "gap": "8px",
            "minWidth": "0"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "line"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.params.line} != ''"
              },
              "type": "expr"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "{session.custom.style} + '/text/muted'"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.params.line}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": "11px",
            "lineHeight": 1.35,
            "minWidth": "0",
            "overflow": "hidden",
            "textOverflow": "ellipsis",
            "whiteSpace": "nowrap"
          },
          "text": ""
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.tooltip.text": {
        "binding": {
          "config": {
            "expression": "{view.params.tip}"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "direction": "column",
      "justify": "center",
      "style": {
        "classes": "wd-node",
        "gap": "2px",
        "height": "100%",
        "minWidth": "0",
        "overflow": "hidden",
        "width": "100%"
      },
      "tooltip": {
        "enabled": true
      }
    },
    "type": "ia.container.flex"
  }
}
