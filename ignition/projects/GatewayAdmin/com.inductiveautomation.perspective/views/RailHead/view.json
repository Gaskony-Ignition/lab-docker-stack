{
  "custom": {},
  "params": {
    "badge": "badge-neutral",
    "name": "",
    "state": "",
    "tip": ""
  },
  "propConfig": {
    "params.badge": {
      "paramDirection": "input"
    },
    "params.name": {
      "paramDirection": "input"
    },
    "params.state": {
      "paramDirection": "input"
    },
    "params.tip": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 22,
      "width": 260
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "name"
        },
        "position": {
          "basis": "auto",
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.params.name}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": "11px",
            "fontWeight": "700",
            "letterSpacing": "0.1em",
            "lineHeight": 1.4,
            "whiteSpace": "nowrap"
          },
          "text": ""
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "badge",
          "tooltip": {
            "enabled": true,
            "text": ""
          }
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "expression": "{view.params.tip}"
              },
              "type": "expr"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "{session.custom.style} + '/status/' + {view.params.badge}"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.params.state}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": "10px",
            "lineHeight": 1.4,
            "padding": "0 8px",
            "whiteSpace": "nowrap"
          },
          "text": "",
          "tooltip": {
            "enabled": true
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "direction": "row",
      "style": {
        "gap": "8px",
        "width": "100%"
      }
    },
    "type": "ia.container.flex"
  }
}
