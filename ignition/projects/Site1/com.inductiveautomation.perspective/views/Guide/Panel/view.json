                "props": {
                  "style": {
                    "fontSize": "11px",
                    "fontWeight": "700",
                    "letterSpacing": "0.08em",
                    "lineHeight": "1.4",
                    "opacity": "0.75",
                    "whiteSpace": "pre-wrap"
