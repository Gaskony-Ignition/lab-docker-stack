{
  "custom": {},
  "params": {
    "topic": "styling"
  },
  "propConfig": {
    "params.topic": {
      "paramDirection": "input"
    }
  },
  "props": {
    "defaultSize": {
      "height": 640,
      "width": 640
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "title"
                },
                "position": {
                  "basis": "auto",
                  "shrink": 0
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "config": {
                        "expression": "{session.custom.style} + '/text/h1'"
                      },
                      "type": "expr"
                    }
                  },
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "{view.params.topic}"
                      },
                      "transforms": [
                        {
                          "code": "\timport demo_guide\n\treturn demo_guide.get(value)['title']\n",
                          "type": "script"
                        }
                      ],
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontSize": "21px",
                    "fontWeight": "700",
                    "lineHeight": "1.4",
                    "whiteSpace": "pre-wrap"
                  },
                  "text": ""
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "where"
                },
                "position": {
                  "basis": "auto",
                  "shrink": 0
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "config": {
                        "expression": "{session.custom.style} + '/text/muted'"
                      },
                      "type": "expr"
                    }
                  },
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "{view.params.topic}"
                      },
                      "transforms": [
                        {
                          "code": "\timport demo_guide\n\treturn demo_guide.get(value)['where']\n",
                          "type": "script"
                        }
                      ],
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontSize": "12px",
                    "letterSpacing": "0.05em",
                    "lineHeight": "1.4",
                    "textTransform": "uppercase",
                    "whiteSpace": "pre-wrap"
                  },
                  "text": ""
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "head"
            },
            "position": {
              "basis": "auto",
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "gap": "4px",
              "style": {
                "width": "100%"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "lead"
            },
            "position": {
              "basis": "auto",
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "{view.params.topic}"
                  },
                  "transforms": [
                    {
                      "code": "\timport demo_guide\n\treturn demo_guide.get(value)['lead']\n",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "fontSize": "14px",
                "lineHeight": "1.4",
                "whiteSpace": "pre-wrap"
              },
              "text": ""
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "steps"
            },
            "position": {
              "basis": "auto",
              "grow": 0,
              "shrink": 0
