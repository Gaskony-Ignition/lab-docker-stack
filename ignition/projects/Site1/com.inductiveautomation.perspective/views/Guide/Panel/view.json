            "propConfig": {
              "props.instances": {
                "binding": {
                  "config": {
                    "expression": "{view.params.topic}"
                  },
                  "transforms": [
                    {
                      "code": "\timport demo_guide\n\treturn demo_guide.steps(value)\n",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              }
            },
            "props": {
              "direction": "column",
              "elementPosition": {
                "basis": "auto",
                "grow": 0,
                "shrink": 0
              },
              "instances": [],
              "path": "Guide/Step",
              "style": {
                "gap": "16px",
                "width": "100%"
              },
              "useDefaultViewHeight": false,
              "useDefaultViewWidth": false
            },
            "type": "ia.display.flex-repeater"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "eye"
                },
                "position": {
                  "basis": "50px",
                  "grow": 0,
                  "shrink": 0
