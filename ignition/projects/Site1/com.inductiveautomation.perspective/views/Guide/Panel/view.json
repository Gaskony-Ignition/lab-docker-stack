                      "transforms": [
                        {
                          "code": "\timport demo_guide\n\treturn demo_guide.get(value)['watch']\n",
                          "type": "script"
                        }
                      ],
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "fontSize": "13px",
                    "lineHeight": "1.4",
                    "whiteSpace": "pre-wrap"
                  },
                  "text": ""
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "watch"
            },
            "position": {
              "basis": "auto",
              "shrink": 0
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "config": {
                    "expression": "{view.params.topic}"
                  },
                  "transforms": [
                    {
                      "code": "\timport demo_guide\n\treturn demo_guide.get(value)['watch'] != ''\n",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              },
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "{session.custom.style} + '/containers/card'"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "alignItems": "start",
              "direction": "row",
              "gap": "12px",
              "style": {
                "width": "100%"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "note"
            },
            "position": {
              "basis": "auto",
              "shrink": 0
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "config": {
                    "expression": "{view.params.topic}"
                  },
                  "transforms": [
                    {
                      "code": "\timport demo_guide\n\treturn demo_guide.get(value)['note'] != ''\n",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              },
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "{session.custom.style} + '/text/muted'"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "{view.params.topic}"
                  },
                  "transforms": [
                    {
                      "code": "\timport demo_guide\n\treturn demo_guide.get(value)['note']\n",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "fontSize": "12px",
                "fontStyle": "italic",
                "lineHeight": "1.4",
                "whiteSpace": "pre-wrap"
              },
              "text": ""
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "shell"
        },
        "position": {
          "basis": "auto",
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "{session.custom.style} + '/containers/page'"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "direction": "column",
          "gap": "14px",
          "style": {
            "height": "100%",
            "minHeight": "0",
            "overflow": "auto",
            "padding": "18px 20px",
            "width": "100%"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "height": "100%",
        "minHeight": "0",
        "width": "100%"
      }
    },
    "type": "ia.container.flex"
  }
}